# BRANDVAULT AI — Environment Configuration Example

# Project Identity
PROJECT_NAME="BRANDVAULT AI"
PROJECT_TAGLINE="Protect Every Word. Preserve Every Identity."
VERSION="1.0.0"

# Backend & Server Settings
PORT=8000
HOST=127.0.0.1
SECRET_KEY="brandvault-enterprise-secret-key-2026"

# Database Configuration
# Default: Local persistent SQLite
DATABASE_URL="sqlite:///./brandvault.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/brandvault"

# AI & LLM Provider API Keys (Optional — system runs 100% reliably out of the box with built-in heuristic agents)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"

