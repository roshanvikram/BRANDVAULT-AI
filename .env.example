# BRANDVAULT AI — Environment Configuration Example

# Project Identity
PROJECT_NAME="BRANDVAULT AI"
PROJECT_TAGLINE="Protect Every Word. Preserve Every Identity."
VERSION="1.0.0"

# Backend & Server Settings
PORT=8000
HOST=127.0.0.1
# Generate a strong random value in production (do NOT ship this default).
SECRET_KEY="brandvault-enterprise-secret-key-2026"
ENVIRONMENT="development"   # development | production

# CORS — comma-separated allowed origins. Leave unset in dev (localhost is
# allowed by default). In production set your frontend origin(s), e.g.:
# BACKEND_CORS_ORIGINS="https://brandvault.vercel.app"
BACKEND_CORS_ORIGINS=""

# Database Configuration
# Default: Local persistent SQLite
DATABASE_URL="sqlite:///./brandvault.db"
# Production PostgreSQL example (psycopg2 driver):
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/brandvault"

# AI & LLM Provider API Keys (Optional — system runs 100% reliably out of the box
# with built-in deterministic heuristic agents. Set ANTHROPIC_API_KEY to enable the
# generative LLM augmentation layer; on any failure it falls back to heuristics.)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# LLM layer controls (all optional)
LLM_ENABLED="true"              # set "false" to force heuristic-only
LLM_PROVIDER="auto"             # auto | anthropic | openai | gemini | none
ANTHROPIC_MODEL="claude-opus-5-5"
LLM_TIMEOUT_SECONDS="20"
LLM_MAX_TOKENS="1500"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"

