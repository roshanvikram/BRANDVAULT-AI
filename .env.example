# BRANDVAULT AI — Environment Configuration Example

# Project Identity
PROJECT_NAME="BRANDVAULT AI"
PROJECT_TAGLINE="Protect Every Word. Preserve Every Identity."
VERSION="1.0.0"

# Backend & Server Settings
PORT=8000
HOST=127.0.0.1
# Generate a strong random value in production (do NOT ship this default).
SECRET_KEY="brandvault-enterprise-secret-key-2026"
ENVIRONMENT="development"   # development | production

# CORS — comma-separated allowed origins. Leave unset in dev (localhost is
# allowed by default). In production set your frontend origin(s), e.g.:
# BACKEND_CORS_ORIGINS="https://brandvault.vercel.app"
BACKEND_CORS_ORIGINS=""

# Database Configuration
# Default: Local persistent SQLite
DATABASE_URL="sqlite:///./brandvault.db"
# Production PostgreSQL example (psycopg2 driver):
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/brandvault"

# AI & LLM Provider API Keys (Optional — system runs 100% reliably out of the box
# with built-in deterministic heuristic agents. Set ANTHROPIC_API_KEY to turn on the
# GENERATIVE AI features — AI Copy Studio (brand-compliant rewrites) and natural-
# language Brand Assistant answers — plus LLM-augmented content analysis. Works even
# without the `anthropic` SDK installed (a built-in HTTP driver calls the Messages
# API directly). On any failure it falls back to the deterministic engine, labelled
# honestly as "heuristic" — it never fakes an AI result.)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# LLM layer controls (all optional)
LLM_ENABLED="true"              # set "false" to force heuristic-only
LLM_PROVIDER="auto"             # auto | anthropic | openai | gemini | none
ANTHROPIC_MODEL="claude-opus-5-5"
LLM_TIMEOUT_SECONDS="20"
LLM_MAX_TOKENS="1500"

# Google OAuth (Optional — "Continue with Google")
# The button stays DISABLED with a "configure to enable" note until BOTH the
# client id and secret are set. The secret is used only server-side in the token
# exchange and is never exposed to the browser. The redirect URI must EXACTLY
# match an Authorized redirect URI configured on the Google OAuth client.
# Public origin the OAuth flow redirects back to after sign-in:
FRONTEND_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/v1/auth/google/callback"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"

# Optional: a real recorded walkthrough video for the /guide page. When set, the
# "Watch the walkthrough" section embeds this instead of the built-in animated
# narrated tour. Use a direct video file URL (.mp4/.webm) or an embeddable
# player URL (e.g. a YouTube/Vimeo /embed/ link). Leave empty to use the
# built-in animated walkthrough.
NEXT_PUBLIC_GUIDE_VIDEO_URL=""

